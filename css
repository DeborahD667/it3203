/* One stylesheet for all six pages. No framework or JavaScript is used. */
/* Element selectors set the general page style. */
body {
  margin: 0;
  background-color: #f2f2f2;
  color: #222222;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 16px;
  line-height: 1.6;
}

/* Class selectors are used for shared parts of the site. */
.site-header {
  padding: 20px;
  background-color: #244766;
  color: white;
  text-align: center;
}
.site-title {
  margin: 0;
  font-size: 26px;
  font-weight: bold;
}
.site-header p { margin: 5px 0 15px; }

/* Flexbox keeps the menu links together and lets them wrap. */
nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px 20px;
}
nav a { color: white; }
nav a:hover { color: #ffdf91; }
nav a[aria-current="page"] { font-weight: bold; }

/* An ID selector styles the main content area. */
#main {
  max-width: 900px;
  margin: 25px auto;
  padding: 25px;
  background-color: white;
  border: 1px solid #cccccc;
}
h1 { margin-top: 0; font-size: 30px; color: #244766; }
h2 { font-size: 23px; color: #244766; }
h3 { font-size: 19px; }
section { margin: 25px 0; }
p { margin: 12px 0; }
li { margin-bottom: 8px; }
a { color: #174b78; }
a:hover { color: #883b16; }
a:focus-visible { outline: 3px solid #bb6b16; outline-offset: 3px; }

/* Images stay within the page, including on smaller screens. */
img { display: block; max-width: 100%; height: auto; }
figure { margin: 20px 0; }
figcaption, .source-note { font-size: 14px; color: #555555; }

/* A simple bordered table compares the versions of HTTP. */
.table-container { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 15px; }
caption { margin-bottom: 10px; text-align: left; font-weight: bold; }
th, td { border: 1px solid #aaaaaa; padding: 10px; text-align: left; vertical-align: top; }
thead th { background-color: #e4edf5; }

pre { padding: 15px; background-color: #eeeeee; border: 1px solid #cccccc; overflow-x: auto; }
dt { font-weight: bold; }
dd { margin: 5px 0 15px 20px; }
.note { margin: 20px 0; padding: 15px; background-color: #edf3f8; border-left: 4px solid #244766; }
footer { padding: 15px; text-align: center; background-color: #dddddd; font-size: 14px; }
.skip-link { position: absolute; top: -60px; left: 10px; padding: 10px; background: white; }
.skip-link:focus { top: 10px; }

/* Basic support for narrow screens. */
@media (max-width: 600px) {
  #main { margin: 15px 10px; padding: 18px; }
  h1 { font-size: 26px; }
  nav { gap: 8px 15px; }
}
